<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 430" width="900" height="430" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata><defs><marker id="a" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><polygon points="0 0,10 4,0 8" fill="#555"/></marker></defs><rect width="900" height="430" fill="#ffffff"/><text x="450.0" y="34" text-anchor="middle" font-family="Arial" font-size="22" font-weight="bold" fill="#111">Les 3 façons d'exécuter Spark</text><rect x="40" y="90" width="250" height="240" rx="12" fill="#fff3cd" stroke="#e0a800" stroke-width="2"/><text x="165.0" y="210.0" text-anchor="middle" font-family="Arial" font-size="20" font-weight="bold" fill="#1a1a1a">1. local[*]</text><text x="165.0" y="232.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">1 seule JVM</text><text x="165.0" y="250.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">driver + executors</text><text x="165.0" y="268.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">dans le même process</text><text x="165.0" y="286.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444"></text><text x="165.0" y="304.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">Usage : apprendre, tester</text><rect x="325" y="90" width="250" height="240" rx="12" fill="#d4edda" stroke="#28a745" stroke-width="2"/><text x="450.0" y="210.0" text-anchor="middle" font-family="Arial" font-size="20" font-weight="bold" fill="#1a1a1a">2. Standalone Docker</text><text x="450.0" y="232.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">Master + Workers</text><text x="450.0" y="250.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">(notre cluster ce blog)</text><text x="450.0" y="268.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444"></text><text x="450.0" y="286.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">Usage : simuler un vrai</text><text x="450.0" y="304.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">cluster sur son poste</text><rect x="610" y="90" width="250" height="240" rx="12" fill="#cce5ff" stroke="#007bff" stroke-width="2"/><text x="735.0" y="210.0" text-anchor="middle" font-family="Arial" font-size="20" font-weight="bold" fill="#1a1a1a">3. YARN / Kubernetes</text><text x="735.0" y="232.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">Cluster de production</text><text x="735.0" y="250.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">spark-submit</text><text x="735.0" y="268.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444"></text><text x="735.0" y="286.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">Usage : entreprise</text><text x="735.0" y="304.0" text-anchor="middle" font-family="Arial" font-size="13" fill="#444">(vu aux Blogs 9 et 12)</text><line x1="290" y1="210" x2="325" y2="210" stroke="#555" stroke-width="2.5" marker-end="url(#a)"/><line x1="575" y1="210" x2="610" y2="210" stroke="#555" stroke-width="2.5" marker-end="url(#a)"/><text x="450" y="370" text-anchor="middle" font-family="Arial" font-size="15" fill="#333">Même code PySpark : seul le paramètre master() change</text><text x="450" y="395" text-anchor="middle" font-family="monospace" font-size="14" fill="#333">local[*]  →  spark://spark-master:7077  →  yarn / k8s://...</text></svg>